# Cypress end-to-end environment (docs/e2e.md). Copy to .env.e2e and fill APP_KEY, BLIND_INDEX_KEY and the
# database/redis credentials. Its own database, Redis DBs, Mongo database, stream prefix and log file: never the dev data.

APP_NAME=TaxiKosmos
APP_ENV=e2e
APP_KEY=
# After rotating APP_KEY, list the old key(s) here (comma separated, e.g. base64:abc…,base64:def…) so
# existing data stays readable, run `php artisan pii:reencrypt`, then empty this list. See docs/security.md.
APP_PREVIOUS_KEYS=
# HMAC key for the searchable-PII lookup columns (phone_hash, license_number_hash). Must be a separate
# secret from APP_KEY, at least 32 characters (generate: openssl rand -hex 32). Do not change it without
# running `php artisan pii:reencrypt`, which rebuilds every hash; until then lookups find nothing.
BLIND_INDEX_KEY=
# Region used to read phone numbers typed without a country code (E.164 normalisation)
PHONE_DEFAULT_REGION=AM

# Admin panel defaults (fallback for the launch-country decision)
BASE_CURRENCY=AMD
ADMIN_DISPLAY_TIMEZONE=Asia/Yerevan
# Minutes of inactivity before an admin is signed out (SESSION_LIFETIME must be >= this)
ADMIN_IDLE_TIMEOUT=60

# Real-time events: Redis Streams read by the Node/Socket.io service (docs/realtime-events.md)
REALTIME_REDIS_CONNECTION=default
REALTIME_STREAM_PREFIX=e2e:events:
REALTIME_STREAM_MAXLEN=100000
REALTIME_GEO_KEY=e2e:drivers:locations
REALTIME_LAST_SEEN_KEY=e2e:drivers:last_seen
PUSH_DRIVER=log
APP_DEBUG=false
APP_URL=http://127.0.0.1:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=taxikosmos_e2e
DB_USERNAME=taxikosmos
DB_PASSWORD=taxikosmos
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=taxikosmos_e2e
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8001
STRIPE_KEY=
STRIPE_SECRET=
GOOGLE_MAPS_API_KEY=
TWOGIS_API_KEY=
MAPS_PROVIDER=fake
# Driver and vehicle papers (P2-T3): private disk (switch to an S3-compatible disk with DRIVER_DOCUMENTS_DISK=s3),
# the types a driver needs approved before verification (background_check is optional by default),
# how long a signed file link lives (minutes) and the upload size limit (KB).
DRIVER_DOCUMENTS_DISK=driver_documents
DRIVER_REQUIRED_DOCUMENTS=license,id_card,vehicle_registration,insurance
DRIVER_DOCUMENT_URL_TTL=5
DRIVER_DOCUMENT_MAX_KB=8192

# Audit log retention in days (default 2 years). Older entries are removed by the daily activitylog:clean job.
ACTIVITYLOG_RETENTION_DAYS=730

# Max rows in the Activity Log CSV export.
AUDIT_EXPORT_MAX_ROWS=50000

# Most points a zone polygon may have.
ZONE_MAX_VERTICES=5000

# Mobile sign-in (P3-T3). SMS_DRIVER=log writes codes to the log instead of sending SMS (local, testing, staging).
SMS_DRIVER=log
MOBILE_ACCESS_TTL_MINUTES=60
MOBILE_REFRESH_TTL_DAYS=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Fixed OTP for listed phones, only honoured when APP_ENV is local, testing or e2e (for mobile E2E tests).
OTP_TEST_CODE=123456
OTP_TEST_PHONES=+37491770001,+37491770002,+37491770003,+37491770004,+37491770005,+37491770006,+37491770007,+37491770008,+37491770009,+37491770010,+37491770011,+37491770012,+37491770013,+37491770014,+37491770015,+37491770016,+37491770017,+37491770018,+37491770019,+37491770020,+37491770021,+37491770022,+37491770023,+37491770024,+37491770025,+37491770026,+37491770027,+37491770028,+37491770029,+37491770030,+37491770031,+37491770032,+37491770033,+37491770034,+37491770035,+37491770036,+37491770037,+37491770038,+37491770039,+37491510001,+37491510002,+37491520001,+37491520002,+37491520003,+37491520004,+37491520005,+37491520006,+37491520007,+37491520008,+37491520009,+37491520010,+37491520011,+37491520012,+37491520013,+37491520021,+37491520022,+37491520023,+37491520024,+37491520025,+37491520026,+37491520027,+37491520031,+37491520032,+37491520033,+37491520034,+37491520035,+37491520036,+37491520041,+37491520042,+37491520043,+37491520044,+37491520045,+37491520046,+37491520047,+37491520048,+37491520049,+37491520051,+37491520052,+37491520053,+37491520054,+37491520055,+37491520056,+37491520057,+37491520058,+37491520059,+37491520061,+37491520062,+37491520063
# Audiences accepted from the native sign-in SDKs (comma separated).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- e2e overrides ---
REDIS_DB=4
REDIS_CACHE_DB=5
LOG_FILE=e2e.log
SOCKET_SERVICE_TOKEN=e2e-socket-service-token-0123456789abcdef
SOCKET_SERVICE_ALLOWED_IPS=127.0.0.1,::1
