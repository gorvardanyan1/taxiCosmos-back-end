{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true,
        "resolveJsonModule": true,
        "baseUrl": ".",
        "paths": { "@/*": ["resources/js/*"] },
        "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"]
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.tsx", "vite.config.ts", "vitest.config.ts"]
}
