APP_NAME=TaxiKosmos
APP_ENV=local
APP_KEY=
# After rotating APP_KEY, list the old key(s) here (comma separated, e.g. base64:abc…,base64:def…) so
# existing data stays readable, run `php artisan pii:reencrypt`, then empty this list. See docs/security.md.
APP_PREVIOUS_KEYS=
# HMAC key for the searchable-PII lookup columns (phone_hash, license_number_hash). Must be a separate
# secret from APP_KEY, at least 32 characters (generate: openssl rand -hex 32). Do not change it without
# running `php artisan pii:reencrypt`, which rebuilds every hash; until then lookups find nothing.
BLIND_INDEX_KEY=
# Region used to read phone numbers typed without a country code (E.164 normalisation)
PHONE_DEFAULT_REGION=AM

# Admin panel defaults (fallback for the launch-country decision)
BASE_CURRENCY=AMD
ADMIN_DISPLAY_TIMEZONE=Asia/Yerevan
# Minutes of inactivity before an admin is signed out (SESSION_LIFETIME must be >= this)
ADMIN_IDLE_TIMEOUT=60

# Real-time events: Redis Streams read by the Node/Socket.io service (docs/realtime-events.md)
REALTIME_REDIS_CONNECTION=default
REALTIME_STREAM_PREFIX=taxikosmos:events:
REALTIME_STREAM_MAXLEN=100000
# Live driver positions (P8-T2), shared with the Node service: use these exact key names there.
REALTIME_GEO_KEY=drivers:locations
REALTIME_LAST_SEEN_KEY=drivers:last_seen
APP_DEBUG=true
APP_URL=http://localhost:8000

# The languages are en, ru and hy (config/taxikosmos.php → locales). English is the default and the fallback;
# the language of a request is chosen per admin / per browser (docs/localisation.md).
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=taxikosmos
DB_USERNAME=taxikosmos
DB_PASSWORD=taxikosmos
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies are Secure automatically when APP_ENV is staging or production (HttpOnly and SameSite=Lax always);
# set true/false here only to override, e.g. false for plain-HTTP local use of a staging build.
# SESSION_SECURE_COOKIE=

# Abuse protection and admin hardening (docs/security.md, docs/rate-limits.md)
# Comma separated IPs/CIDRs allowed to reach /admin, /horizon and the admin sign-in screens. Empty = anyone (off).
ADMIN_IP_ALLOWLIST=
# Reverse proxies whose X-Forwarded-* headers are trusted (addresses/CIDRs, or *). Needed behind a proxy so the
# client IP (rate limits, allowlist) and HTTPS (HSTS, Secure cookies) are right. Empty = trust none.
TRUSTED_PROXIES=
# Admin roles that must use two-factor authentication (comma separated). Blank or unset = super_admin,finance; the word "none" switches the rule off.
ADMIN_2FA_REQUIRED_ROLES=
# Strict-Transport-Security max-age in seconds (HTTPS responses only; 0 = off) and a report-only CSP switch.
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CSP_REPORT_ONLY=false
# Requests per minute: signed-in admin, admin auth POSTs per IP+path, POST /login per IP, signed-in app user, payments.
RATE_LIMIT_ADMIN=300
RATE_LIMIT_ADMIN_AUTH=30
RATE_LIMIT_LOGIN_IP=30
RATE_LIMIT_API=120
RATE_LIMIT_PAYMENT=10

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=taxikosmos
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000
STRIPE_KEY=
STRIPE_SECRET=
GOOGLE_MAPS_API_KEY=
TWOGIS_API_KEY=
# Maps provider (P5-T1, docs/geo.md): google | 2gis in production; fake = no key, no network, made-up answers (local, testing, e2e only).
MAPS_PROVIDER=google
# Seconds a provider call may take, metres around the user that autocomplete prefers, and how long reverse geocodes / routes are remembered (seconds, 0 = off; coordinates rounded to MAPS_CACHE_PRECISION decimals).
MAPS_TIMEOUT=5
MAPS_BIAS_RADIUS_METERS=50000
MAPS_CACHE_PRECISION=4
MAPS_CACHE_REVERSE_TTL=3600
MAPS_CACHE_ROUTE_TTL=600
# Requests per minute per signed-in rider/driver for the four /api/v1/geo endpoints together.
RATE_LIMIT_GEO=60
RATE_LIMIT_DRIVER_LOCATION=30
RATE_LIMIT_DRIVER_AVAILABILITY=10
RATE_LIMIT_DEVICES=30
# Driver pings (P8-T2): minutes without a ping before an online driver is marked offline, and days a ping is kept in MongoDB.
DRIVER_STALE_AFTER_MINUTES=5
DRIVER_PING_RETENTION_DAYS=90
# Push notifications (P8-T4): expo sends through the Expo Push Service; log writes the push to the log and sends nothing (the default
# outside production). Production must choose. EXPO_ACCESS_TOKEN is only needed with Expo's enhanced push security.
PUSH_DRIVER=log
EXPO_ACCESS_TOKEN=
PUSH_TIMEOUT=10
PUSH_OFFER_TTL=30
PUSH_RECEIPT_DELAY_MINUTES=15
PUSH_TICKET_RETENTION_HOURS=24
# Driver and vehicle papers (P2-T3): private disk (switch to an S3-compatible disk with DRIVER_DOCUMENTS_DISK=s3),
# the types a driver needs approved before verification (background_check is optional by default),
# how long a signed file link lives (minutes) and the upload size limit (KB).
DRIVER_DOCUMENTS_DISK=driver_documents
DRIVER_REQUIRED_DOCUMENTS=license,id_card,vehicle_registration,insurance
DRIVER_DOCUMENT_URL_TTL=5
DRIVER_DOCUMENT_MAX_KB=8192

# Audit log retention in days (default 2 years). Older entries are removed by the daily activitylog:clean job.
ACTIVITYLOG_RETENTION_DAYS=730

# Max rows in the Activity Log CSV export.
AUDIT_EXPORT_MAX_ROWS=50000

# Most points a zone polygon may have.
ZONE_MAX_VERTICES=5000

# Mobile sign-in (P3-T3). SMS_DRIVER=log writes codes to the log instead of sending SMS (local, testing, staging).
SMS_DRIVER=log
MOBILE_ACCESS_TTL_MINUTES=60
MOBILE_REFRESH_TTL_DAYS=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Fixed OTP for listed phones, only honoured when APP_ENV is local, testing or e2e (for mobile E2E tests).
OTP_TEST_CODE=
OTP_TEST_PHONES=
# Audiences accepted from the native sign-in SDKs (comma separated).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Fare estimates (docs/fares.md)
FARE_QUOTE_TTL_MINUTES=10
FARE_ESTIMATE_RANGE_BPS=1000
FARE_SURGE_CAP_HUNDREDTHS=300
FARE_ROUTE_DETOUR_PERCENT=130
FARE_ROUTE_AVERAGE_SPEED_KMH=30
SAVED_PLACES_MAX=20
